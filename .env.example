# ==============================================================================
# hey-yu (Coordinate of Code) — Environment Configuration Template
# ==============================================================================
# hey-yu is a 100% deterministic local-first AST spatial coordinate engine.
# Zero API keys or cloud services are required.

# Optional explicit project or workspace root override
# HEY_YU_PROJECT_ROOT=/path/to/your/project
# HEY_YU_WORKSPACE_ROOT=/path/to/your/workspace

# Optional blindfold benchmark mode (set to 1 only during empirical A/B benchmarking)
# HEY_YU_BLINDFOLD_BENCHMARK=0
