# ==============================================================================
# hey-yu (Coordinate of Code v0.1.0-alpha) — Environment Configuration Template
# ==============================================================================
# hey-yu is a 100% deterministic local-first AST spatial coordinate engine.
# Zero API keys or cloud services are required.

# Optional explicit project root override (auto-discovered from workspace if omitted)
# HEY_YU_PROJECT_ROOT=/path/to/your/project

# Optional flag to skip global ~/.gemini MCP registration during isolated tests/CI
# HEY_YU_SKIP_GLOBAL_MCP=0
